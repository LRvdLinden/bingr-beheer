<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements van de widget-extensie op de Mac (Mac Catalyst; CODE_SIGN_ENTITLEMENTS[sdk=macosx*] in ios/project.yml).
  Extensies op macOS moeten in de sandbox; netwerk voor widget_summary; alleen de gedeelde Keychain-groep (widget-token).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)nl.lrvdlinden.bingr.beheer.shared</string>
	</array>
</dict>
</plist>
