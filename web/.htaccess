# Beheer: nooit indexeren en nooit in een frame tonen
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Content-Type-Options "nosniff"
  # build 97: strikte Content-Security-Policy (geen inline scripts of styles; alleen de functie admin op Supabase)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' https://vjewsncmsxmhmhnoxwqx.supabase.co; img-src 'self' data: blob: https:; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>

# Alleen via https://beheer.bingr.online: ligt de map van het subdomein binnen de webmap van bingr.online
# (bv. bingr.online/beheer.bingr.online/), dan stuurt elke andere host door naar het subdomein
<IfModule mod_rewrite.c>
  RewriteEngine On
  # altijd https, naar hetzelfde pad (pad uit de oorspronkelijke aanvraagregel, niet het interne pad van de map;
  # NE: het pad is al gecodeerd, de querystring gaat automatisch mee)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} ^beheer\.bingr\.online$ [NC]
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/[^\s?]*)
  RewriteRule ^ https://beheer.bingr.online%1 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} !^beheer\.bingr\.online$ [NC]
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^ https://beheer.bingr.online/ [R=302,L]
</IfModule>

# Builds (map builds/) nooit rechtstreeks: alleen via dl.php met een kortgeldige link uit het beheer
Options -Indexes
<IfModule mod_alias.c>
  RedirectMatch 404 ^/builds(/|$)
</IfModule>
