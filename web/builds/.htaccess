# Builds van Bingr: nooit rechtstreeks op te halen, alleen via dl.php (kortgeldige link uit het beheer; de nieuwste
# Android-APK ook openbaar via dl.php?app=android voor de testversie op bingr.online).
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
Options -Indexes
